[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
# Doar pentru pachete critice, nu la orice update marunt
Target = linux
Target = linux-lts
Target = linux-zen
Target = nvidia
Target = nvidia-dkms
Target = nvidia-open-dkms

[Action]
Description = FortressArch: creez snapshot inainte de update critic...
When = PreTransaction
Exec = /usr/local/bin/fortress-snapshot.sh
